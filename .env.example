# CTFd
CTFD_URL=https://ctf.hackathon.ke
CTFD_TOKEN=
# Password login is used when CTFD_TOKEN is empty
CTFD_USER=
CTFD_PASS=

# API keys (not needed for codex-cli login; use for claude/google/bedrock/azure)
# Codex uses its own login (`codex login`), so no key is required here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# DeepSeek is OpenAI-compatible and works with the pydantic-ai solver.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OpenCode Zen key (big-pickle etc.). The raw API may be free-tier limited;
# the `opencode` CLI/commander can still use big-pickle.
OPENCODE_ZEN_API_KEY=

# Event tuning
# Private/LAN web_fetch is allowed by default. Set to 1 to restore upstream blocking.
CTF_BLOCK_PRIVATE_FETCH=
# Comma-separated solver lineup (empty = backend/models.py DEFAULT_MODELS)
# Codex-only (this host):
CTF_MODELS=codex/gpt-5.4,codex/gpt-5.4-mini
# Mixed example: claude-sdk/claude-opus-4-6/medium,codex/gpt-5.4,deepseek/deepseek-flash
# Big Pickle (opencode CLI/commander only): opencode/big-pickle
# Container math: MAX_CONCURRENT_CHALLENGES x len(CTF_MODELS) containers
MAX_CONCURRENT_CHALLENGES=1
CONTAINER_MEMORY_LIMIT=4g
CTF_MSG_PORT=9400
CTF_BUDGET_USD=0
CTF_TOTAL_HOURS=15

# Report/control center (bind loopback, reach via SSH tunnel or Tailscale if remote)
REPORT_HOST=127.0.0.1
REPORT_PORT=8080
# Required before binding a non-loopback host. Visitors enter this once in the UI.
PANEL_TOKEN=
# Max multipart upload for challenge distfiles (MB)
PANEL_MAX_UPLOAD_MB=128
